P_D = 0.01
P_not_D = 1 - P_D

P_Pos_given_D = 0.99
P_Pos_given_not_D = 0.05

P_D_given_Pos = (
    (P_Pos_given_D * P_D) /
    ((P_Pos_given_D * P_D) + (P_Pos_given_not_D * P_not_D))
)

print("Probability of having the disease given a positive test result:")
print(f"{P_D_given_Pos:.4f}")
print(f"{P_D_given_Pos * 100:.2f}%")
